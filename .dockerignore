# .yarn/ needs to be copied in CI to make use of caching, please do not ignore
# skip node_modules if any. Note yarn can still generate node_modules if needed
node_modules/
# skip build result
build/
# skip editors
.idea/
# version control, CI and agent files: not needed inside, and .git changes with every commit, which
# would invalidate the `COPY . /app` layers; .claude/ may hold whole worktrees that tsc and eslint
# would pick up
.git
.github/
.claude/
# contributor docs; README.md stays, scripts/readme-html.mjs renders it into the bundle
docs/
# skip dotfiles not needed inside
.dockerignore
.gitignore
.editorconfig
.gitlab-ci.yml
Makefile
deploy/helm/
deploy/*.yml
